{
  "rewrites": [
    {
      "source": "/jogos/no-do-dia",
      "destination": "/jogos/no-do-dia.html"
    },
    {
      "source": "/jogos/no-do-dia/",
      "destination": "/jogos/no-do-dia.html"
    },
    {
      "source": "/jogos",
      "destination": "/jogos.html"
    },
    {
      "source": "/jogos/",
      "destination": "/jogos.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
